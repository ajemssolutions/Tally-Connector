{
  "name": "tally-connector",
  "productName": "Tally Connector",
  "version": "2.0.0",
  "description": "Sync Tally Prime data to AJEMS",
  "main": "src/main.js",
  "author": "AJEMS",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "fast-xml-parser": "^4.4.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0"
  },
  "build": {
    "appId": "in.ajems.tallyconnector",
    "productName": "Tally Connector",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tally Connector"
    },
    "files": [
      "src/**/*",
      "package.json"
    ]
  }
}